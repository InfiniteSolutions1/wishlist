# From Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: also show "Continue with Google" (set up Google in Supabase first).
# NEXT_PUBLIC_GOOGLE_SIGNIN=on

# Secret key. Server only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=your-secret-key
